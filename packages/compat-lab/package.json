{
  "name": "@catoffice/compat-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Golden-corpus compatibility gates: deterministic generate + read/round-trip checks against committed files in compat/golden",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "golden": "tsx scripts/generate-golden.ts"
  },
  "dependencies": {
    "@genoffice/docx-engine": "*",
    "@genoffice/file-parse": "*",
    "@genoffice/pptx-engine": "*",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
