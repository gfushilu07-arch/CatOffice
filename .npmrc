# 所有下载内容与元数据缓存放在外接卷（与全局 pnpm 配置一致），
# 主盘空间有限，项目缓存不入内盘。
store-dir=/Volumes/fushilu/.caches/pnpm/store
cache-dir=/Volumes/fushilu/.caches/pnpm/cache
state-dir=/Volumes/fushilu/.caches/pnpm/state

# npmmirror 同步滞后会导致新版本包 404/无匹配版本，本项目直接用官方源
# （包内容缓存仍在 store-dir 指向的外接卷）。
registry=https://registry.npmjs.org/

# 上游内部包之间用 npm 风格的版本号（^x.y.z）互相引用，pnpm 需要显式允许
# 把这些声明解析到工作区包，否则会去 registry 拉取导致 404。
link-workspace-packages=true
prefer-workspace-packages=true

# electron-builder 会从扁平 node_modules 原样复制 @genspark/cli 及其嵌套
# commander 等路径（见 apps/shell/electron-builder.cjs），shamefully-hoist
# 模拟 npm 的提升布局以保证这些路径存在。
shamefully-hoist=true
